#!/usr/bin/env python3
"""Start, inspect, land and end protonmailcli worktree sessions."""

import argparse
import fcntl
from functools import cache
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
from session_transport import (
    LOOKUP_REMOTE, config_entries, push_settings, supports_config_hooks, transport_environment, with_config,
)


ROOT = Path(__file__).resolve().parents[1]
SESSION_NAME = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
SESSION_BASE = "refs/worktree/protonmailcli/session-base"
SHELL_ENV = {"BASH_ENV", "BASHOPTS", "CDPATH", "ENV", "SHELLOPTS"}
QUALIFICATION_ENV = {
    "GOENV", "GOFLAGS", "GOWORK", "GNUMAKEFLAGS",
    "MAKEFILES", "MAKEFLAGS", "MAKELEVEL", "MAKEOVERRIDES", "MFLAGS",
}


class SessionError(Exception):
    pass


class SessionTerminated(KeyboardInterrupt):
    pass


def terminate_session(_signum, _frame):
    raise SessionTerminated


@cache
def session_environment():
    result = subprocess.run(
        ["git", "rev-parse", "--local-env-vars"], text=True, stdout=subprocess.PIPE,
    )
    if result.returncode:
        raise SessionError("could not determine Git's repository-local environment variables")
    local = set(result.stdout.splitlines()) | SHELL_ENV | {
        "GIT_ATTR_SOURCE", "GIT_NAMESPACE", "GIT_QUARANTINE_PATH",
    }
    return {
        key: value for key, value in os.environ.items()
        if key not in local and not key.startswith(("BASH_FUNC_", "GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_"))
    }


def git(*args, cwd=ROOT, capture=True, extra_env=None, input_text=None):
    env = {**session_environment(), "GIT_NO_REPLACE_OBJECTS": "1", "GIT_GRAFT_FILE": ""}
    env.update(extra_env or {})
    result = subprocess.run(
        ["git", "-C", cwd, *args],
        check=True,
        stdout=subprocess.PIPE if capture else None,
        text=True,
        env=env,
        input=input_text,
    )
    return result.stdout.rstrip("\n") if capture else None


def configured_hook_events(cwd=ROOT, extra_env=None):
    config = git("config", "--null", "--list", "--includes", cwd=cwd, extra_env=extra_env)
    keys = (setting.partition("\n")[0] for setting in config.split("\0"))
    return dict.fromkeys(key for key in keys if key.startswith("hook.") and key.endswith(".event"))


def hooks_disabled(cwd=ROOT, extra_env=None):
    return [part for key in configured_hook_events(cwd, extra_env) for part in ("-c", f"{key}=")]


def checkout_inspection(cwd=ROOT):
    return [*hooks_disabled(cwd), "-c", f"core.hooksPath={os.devnull}", "-c", "core.fsmonitor=false"]


def default_tip(remote, cwd=ROOT):
    config = git("config", "--null", "--list", "--includes", cwd=cwd)
    env = transport_environment(config, session_environment(), remote)
    rows = git(
        f"--git-dir={os.devnull}", "ls-remote", "--symref", "--", LOOKUP_REMOTE, "HEAD",
        cwd=cwd, extra_env=env,
    ).splitlines()
    refs = [row for row in rows if row.endswith("\tHEAD")]
    if len(refs) == 2:
        ref, sha = refs
        branch = re.fullmatch(r"ref: refs/heads/(.+)\tHEAD", ref)
        commit = re.fullmatch(r"([0-9a-f]{40}|[0-9a-f]{64})\tHEAD", sha)
        if branch and commit:
            return branch[1], commit[1]
    raise SessionError("could not resolve the default branch of origin")


def fetch_default(remote, git_options=()):
    branch, _ = default_tip(remote)
    ref = f"refs/heads/{branch}"
    git(*git_options, "fetch", "--no-tags", "--no-prune", "--no-prune-tags", "--refmap=", "--",
        "origin", ref)
    base = git("rev-parse", "--verify", "FETCH_HEAD")
    if default_tip(remote) != (branch, base):
        raise SessionError("origin's default branch changed during fetch; retry")
    return branch, base


def absolute_endpoint(url):
    if re.match(r"^[^/]*:", url):
        return url
    return str((ROOT / Path(url).expanduser()).resolve())


def origin_endpoint(push=False):
    config = git("config", "--null", "--list", "--includes")
    if any(key == "remote.origin.vcs" and value for key, value in config_entries(config)):
        raise SessionError("origin must use a standard Git transport without remote.origin.vcs")
    remote = git("remote", "get-url", "origin")
    if push and remote != git("remote", "get-url", "--push", "--all", "origin"):
        raise SessionError("origin must use the same single URL for fetch and push")
    return absolute_endpoint(remote)


def worktree_path(main_checkout, name):
    return main_checkout.with_name(f"{main_checkout.name}-{name}")


def start(main_checkout, name):
    if not SESSION_NAME.fullmatch(name):
        raise SessionError("use a session name such as mailbox-preview")
    remote = origin_endpoint()
    branch, base = fetch_default(remote)
    session = f"fix/{name}"
    if session == branch:
        raise SessionError("the session branch name matches the remote default branch")
    path = worktree_path(main_checkout, name)
    git(*hooks_disabled(), "-c", f"core.hooksPath={os.devnull}", "worktree", "add",
        "--no-checkout", "--no-track", "-b", session, path, base)
    try:
        git("update-ref", SESSION_BASE, base, cwd=path)
        git(
            *hooks_disabled(cwd=path),
            "-c", f"core.hooksPath={os.devnull}",
            "restore", "--source=HEAD", "--staged", "--worktree", "--", ".", cwd=path,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise SessionError(
            f"setup stopped with the checkout preserved at {path} and base {base}; "
            "see partial checkout recovery in docs/development-sessions.md"
        ) from error
    print(f"Session checkout: {path} (origin/{branch} at {base})")


def current_session(main_checkout, cwd=ROOT):
    branch = git("branch", "--show-current", cwd=cwd)
    name = branch.removeprefix("fix/")
    if name == branch or not SESSION_NAME.fullmatch(name) or ROOT != worktree_path(main_checkout, name):
        raise SessionError("run from the checkout made by scripts/session start")
    try:
        base = git("rev-parse", "--verify", "--quiet", SESSION_BASE, cwd=cwd)
    except subprocess.CalledProcessError as error:
        raise SessionError("this checkout has no session record from scripts/session start") from error
    for marker in (
        "rebase-merge", "rebase-apply", "sequencer", "MERGE_HEAD",
        "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_START",
    ):
        path = git("rev-parse", "--path-format=absolute", "--git-path", marker, cwd=cwd)
        if Path(path).exists():
            raise SessionError("finish the Git operation in this checkout first")
    inspection = checkout_inspection(cwd)
    if git(*inspection, "status", "--porcelain", "--untracked-files=all", cwd=cwd):
        raise SessionError("commit the session's changes or set them aside before continuing")
    if git(*inspection, "ls-files", "--others", "--ignored", "--exclude-standard", cwd=cwd):
        raise SessionError("move ignored files out of the session checkout before continuing")
    tracked = git(*inspection, "ls-files", "-v", "-z", cwd=cwd).split("\0")
    if any(entry.startswith("S ") or entry[:1].islower() for entry in tracked):
        raise SessionError("restore normal index tracking before continuing")
    return branch, base


def require_ancestor(ancestor, descendant, message):
    try:
        git("merge-base", "--is-ancestor", ancestor, descendant)
    except subprocess.CalledProcessError as error:
        raise SessionError(message) from error


def update_session_refs(branch_ref, updates):
    with tempfile.TemporaryDirectory(prefix="protonmailcli-ref-guard-") as directory:
        hook = Path(directory) / "reference-transaction"
        hook.write_text("""#!/bin/sh
if [ "$1" = prepared ]; then
    branch=$(git symbolic-ref --quiet HEAD) || exit 1
    if [ "$branch" != "$PROTONMAILCLI_EXPECTED_BRANCH" ]; then
        echo "session: the checked-out branch changed during installation" >&2
        exit 1
    fi
fi
""")
        hook.chmod(0o700)
        git(
            *checkout_inspection(), "-c", "hook.reference-transaction.enabled=true",
            "-c", f"core.hooksPath={directory}", "update-ref", "--stdin",
            input_text=updates, extra_env={"PROTONMAILCLI_EXPECTED_BRANCH": branch_ref},
        )


def install_candidate(candidate, head, original_head, branch_ref, branch_update):
    options = checkout_inspection(candidate)
    metadata = git("rev-parse", "--absolute-git-dir", cwd=candidate)
    live_index = git("rev-parse", "--path-format=absolute", "--git-path", "index")
    # Use the candidate's detached HEAD with the live index and files. The
    # session's own HEAD remains attached and keeps its branch reserved.
    checkout = [
        *options, f"--git-dir={metadata}", f"--work-tree={ROOT}",
        "checkout", "--no-overwrite-ignore", "--detach",
    ]
    env = {"GIT_INDEX_FILE": live_index}
    git(*options, "update-ref", "--no-deref", "HEAD", original_head, head, cwd=candidate)
    try:
        git(*checkout, head, extra_env=env, capture=False)
        update_session_refs(branch_ref, branch_update)
    except (OSError, subprocess.CalledProcessError, KeyboardInterrupt):
        if git("rev-parse", "HEAD", cwd=candidate) == head:
            current = git("rev-parse", "HEAD")
            if current != head:
                git(*checkout, current, extra_env=env, capture=False)
        raise
    finally:
        git(*options, "update-ref", "--no-deref", "HEAD", head, cwd=candidate)


def rebase_candidate(main_checkout, session, previous_base, base, original_head):
    branch_ref = f"refs/heads/{session}"
    base_update = f"update {SESSION_BASE} {base} {previous_base}\n"
    if git("merge-base", base, original_head) == base:
        update_session_refs(branch_ref, f"verify {branch_ref} {original_head}\n{base_update}")
        return original_head

    holding = Path(tempfile.mkdtemp(prefix="protonmailcli-rebase-"))
    candidate = holding / "checkout"
    try:
        git(*checkout_inspection(), "worktree", "add", "--detach", "--no-checkout",
            candidate, original_head)
        options = checkout_inspection(candidate)
        try:
            git(*options, "restore", "--source=HEAD", "--staged", "--worktree", "--", ".", cwd=candidate)
            try:
                git(
                    *options, "rebase", "--merge", "--no-autostash", "--no-update-refs",
                    "--no-fork-point", "--no-rebase-merges", "--reapply-cherry-picks", base,
                    cwd=candidate, capture=False,
                )
            except (subprocess.CalledProcessError, KeyboardInterrupt):
                marker = git("rev-parse", "--path-format=absolute", "--git-path", "rebase-merge", cwd=candidate)
                if Path(marker).exists():
                    git(*options, "rebase", "--abort", cwd=candidate)
                raise
            head = git("rev-parse", "HEAD", cwd=candidate)
            require_ancestor(base, head, "the candidate must be a fast-forward from the reviewed base")
            if current_session(main_checkout) != (session, previous_base) or git("rev-parse", "HEAD") != original_head:
                raise SessionError("the session changed during rebase; run land again")
            install_candidate(
                candidate, head, original_head, branch_ref,
                f"update {branch_ref} {head} {original_head}\n{base_update}",
            )
            if git("branch", "--show-current") != session or git("rev-parse", "HEAD") != head:
                raise SessionError("the session changed during candidate installation; run land again")
            return head
        finally:
            try:
                git(*checkout_inspection(), "worktree", "remove", candidate)
            except (OSError, subprocess.CalledProcessError) as error:
                raise SessionError(f"temporary rebase worktree retained at {candidate}") from error
    finally:
        if not candidate.exists():
            holding.rmdir()


def run_logged(command, path, cwd=ROOT, extra_env=None):
    env = {
        key: value for key, value in session_environment().items()
        if not key.startswith("PMAIL_") and key not in QUALIFICATION_ENV
    }
    env.update(extra_env or {})
    print(f"Running {command[0]} (log: {path})", flush=True)
    with path.open("w") as log:
        result = subprocess.run(
            command, cwd=cwd, stdin=subprocess.DEVNULL,
            stdout=log, stderr=subprocess.STDOUT, env=env,
        )
    if result.returncode:
        raise SessionError(f"{command[0]} exited {result.returncode}; see {path}")


def review(base, head, evidence, checkout, env):
    schema = evidence / "review-schema.json"
    schema.write_text(json.dumps({
        "type": "object",
        "properties": {
            "findings": {"type": "array", "items": {"type": "string"}},
        },
        "required": ["findings"],
        "additionalProperties": False,
    }))
    verdict = evidence / "review.json"
    run_logged([
        os.environ.get("PROTONMAILCLI_CODEX", "codex"), "exec",
        "--sandbox", "read-only", "--ephemeral", "--output-schema", schema,
        "--output-last-message", verdict,
        f"Statically review the committed change from {base} to {head} in this checkout. "
        "Inspect the diff and relevant tracked code in this checkout. The caller runs "
        "tests and records any checkpoint separately. Keep your work read-only. "
        "Report actionable regressions, safety issues, or missed requirements in the "
        "documented workflow. Treat the remote service and configured hooks as trusted. "
        "Give a path and line for each finding. Return an empty findings "
        "array when the static review is complete and there are no actionable findings. "
        "If the committed diff cannot be read, report that as a finding.",
    ], evidence / "review.log", cwd=checkout, extra_env=env)
    try:
        result = json.loads(verdict.read_text())
        findings = result["findings"]
        if (set(result) != {"findings"} or not isinstance(findings, list)
                or not all(isinstance(item, str) and item.strip() for item in findings)):
            raise ValueError("invalid findings")
    except (OSError, ValueError, TypeError, KeyError) as error:
        raise SessionError(f"Codex produced no valid verdict; see {evidence / 'review.log'}") from error
    if findings:
        raise SessionError(f"Codex reported {len(findings)} finding(s); see {verdict}")


def qualify(session, base, head, evidence):
    with tempfile.TemporaryDirectory(prefix="protonmailcli-qualification-") as directory:
        checkout = Path(directory) / "checkout"
        env = {
            "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_ATTR_NOSYSTEM": "1", "GIT_CEILING_DIRECTORIES": str(Path(directory).parent),
        }
        git(
            "clone", "--quiet", "--no-checkout",
            "--template=", "--config", f"core.hooksPath={os.devnull}",
            "--config", f"core.attributesFile={os.devnull}",
            "--no-local", "--single-branch", "--no-tags", "--branch", session, ROOT, checkout,
            cwd=Path(directory), extra_env=env,
        )
        git("remote", "remove", "origin", cwd=checkout, extra_env=env)
        if git("rev-parse", "HEAD", cwd=checkout, extra_env=env) != head:
            raise SessionError("the session changed before qualification; run land again")
        git("restore", "--source=HEAD", "--staged", "--worktree", "--", ".", cwd=checkout, extra_env=env)
        if git("status", "--porcelain", "--untracked-files=all", "--ignored=matching",
               cwd=checkout, extra_env=env):
            raise SessionError("the qualification checkout is dirty")
        review(base, head, evidence, checkout, env)
        run_logged(
            ["scripts/release-check.sh", "--ci"], evidence / "release-check.log", cwd=checkout,
            extra_env={
                **env, "GOENV": "off", "GOWORK": "off",
                "PROTONMAILCLI_RELEASE_CHECK_DIR": str(evidence / "build"),
            },
        )
        binary = evidence / "build" / "protonmailcli"
        if not binary.is_file() or not os.access(binary, os.X_OK):
            raise SessionError(f"the release check did not produce an executable; see {evidence / 'release-check.log'}")


def push_qualified(remote, branch, base, head, dry_run):
    git_executable = shutil.which("git")
    if not git_executable:
        raise SessionError("could not locate Git for the pre-push check")
    flags = ["--dry-run"] if dry_run else []
    original_hook = git("rev-parse", "--path-format=absolute", "--git-path", "hooks/pre-push")
    config_hooks = supports_config_hooks(git("version"))
    with tempfile.TemporaryDirectory(prefix="protonmailcli-push-") as directory:
        alias = Path(directory).name
        config = git("config", "--null", "--list", "--includes")
        endpoint_env = with_config({}, list(push_settings(config, alias, remote)))
        probe_env = transport_environment(config, {}, remote)
        hook = Path(directory) / "pre-push"
        hook.write_text("""#!/usr/bin/env python3
import errno
import json
import os
import subprocess
import sys
import tempfile

destination = sys.argv[2]
if destination != os.environ["PROTONMAILCLI_QUALIFIED_URL"]:
    sys.exit("session: Git resolved an unexpected push destination")

git = os.environ["PROTONMAILCLI_GIT"]
env = os.environ.copy()
probe_config = json.loads(env.pop("PROTONMAILCLI_PROBE_CONFIG"))
for key in list(env):
    if (key in {"GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS"}
            or key.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_"))):
        env.pop(key)
mode = os.environ["PROTONMAILCLI_RUN_PRE_PUSH"]
if mode == "configured":
    with tempfile.NamedTemporaryFile() as refs:
        refs.write(sys.stdin.buffer.read())
        refs.flush()
        status = subprocess.run(
            [git, "hook", "run", "--ignore-missing", f"--to-stdin={refs.name}", "pre-push", "--",
             "origin", destination],
            env=env,
        ).returncode
        if status:
            sys.exit(status)
elif mode == "file":
    original = os.environ["PROTONMAILCLI_ORIGINAL_HOOK"]
    if os.path.isfile(original) and os.access(original, os.X_OK):
        command = [original, "origin", destination]
        try:
            status = subprocess.run(command, env=env).returncode
        except OSError as error:
            if error.errno != errno.ENOEXEC:
                raise
            status = subprocess.run(["/bin/sh", *command], env=env).returncode
        if status:
            sys.exit(status)

# Reuse the pinned transport settings even if a user hook changed Git config.
for key in ("GIT_CONFIG", "GIT_COMMON_DIR", "GIT_WORK_TREE"):
    env.pop(key, None)
env.update(probe_config)
advertisement = subprocess.run(
    [git, f"--git-dir={os.devnull}", "ls-remote", "--symref", "--",
     os.environ["PROTONMAILCLI_LOOKUP_REMOTE"], "HEAD"],
    stdout=subprocess.PIPE, text=True, env=env,
)
if advertisement.returncode:
    sys.exit(advertisement.returncode)
branch = os.environ["PROTONMAILCLI_QUALIFIED_BRANCH"]
base = os.environ["PROTONMAILCLI_QUALIFIED_BASE"]
expected = {f"ref: refs/heads/{branch}\\tHEAD", f"{base}\\tHEAD"}
if not expected.issubset(advertisement.stdout.splitlines()):
    sys.exit("session: the remote default branch changed before the push")
""")
        hook.chmod(0o700)
        try:
            # The explicit lease compares the remote tip during the push. The
            # caller has already checked that this update is a fast-forward.
            git(
                *hooks_disabled(extra_env=endpoint_env),
                "-c", "hook.pre-push.enabled=true", "-c", f"core.hooksPath={directory}", "push", *flags,
                "--no-follow-tags", "--recurse-submodules=no",
                f"--force-with-lease=refs/heads/{branch}:{base}", "--",
                alias, f"{head}:refs/heads/{branch}", capture=False,
                extra_env={
                    **endpoint_env,
                    "PROTONMAILCLI_PROBE_CONFIG": json.dumps(probe_env),
                    "PROTONMAILCLI_QUALIFIED_URL": remote,
                    "PROTONMAILCLI_QUALIFIED_BRANCH": branch,
                    "PROTONMAILCLI_QUALIFIED_BASE": base,
                    "PROTONMAILCLI_GIT": os.path.abspath(git_executable),
                    "PROTONMAILCLI_LOOKUP_REMOTE": LOOKUP_REMOTE,
                    "PROTONMAILCLI_RUN_PRE_PUSH": "" if dry_run else "configured" if config_hooks else "file",
                    "PROTONMAILCLI_ORIGINAL_HOOK": original_hook,
                },
            )
        except subprocess.CalledProcessError as error:
            raise SessionError(f"git push exited {error.returncode}") from error


def land(main_checkout, dry_run):
    session, previous_base = current_session(main_checkout)
    original_head = git("rev-parse", "HEAD")
    remote = origin_endpoint(push=True)
    no_hooks = checkout_inspection() if dry_run else []
    branch, base = fetch_default(remote, git_options=no_hooks)
    if current_session(main_checkout) != (session, previous_base) or git("rev-parse", "HEAD") != original_head:
        raise SessionError("the session changed during fetch; run land again")
    if session == branch:
        raise SessionError("run land from a feature branch")
    require_ancestor(previous_base, base, f"origin/{branch} no longer descends from this session's base")
    if git("rev-list", "--max-count=1", "--merges", f"{base}..HEAD"):
        raise SessionError("session contains merge commits; prepare a linear branch before landing")
    head = rebase_candidate(main_checkout, session, previous_base, base, original_head)
    require_ancestor(base, head, "the candidate must be a fast-forward from the reviewed base")
    if head == base:
        print(f"Session has no commits ahead of origin/{branch}")
        return
    evidence_root = Path.home() / "Library/Logs/protonmailcli/sessions"
    evidence_root.mkdir(parents=True, exist_ok=True)
    evidence = Path(tempfile.mkdtemp(prefix=f"{session[4:]}-", dir=evidence_root))
    qualify(session, base, head, evidence)
    if current_session(main_checkout) != (session, base) or git("rev-parse", "HEAD") != head:
        raise SessionError("the session changed during qualification; run land again")
    if default_tip(remote) != (branch, base):
        raise SessionError("origin's default branch changed during qualification; run land again")
    push_qualified(remote, branch, base, head, dry_run)
    action = "Dry run passed for" if dry_run else "Landed"
    print(f"{action} {head} on origin/{branch}. Evidence: {evidence}")


def registered_worktree(path, main_checkout):
    records = git("worktree", "list", "--porcelain", "-z", cwd=main_checkout)
    return f"worktree {path}" in records.split("\0")


def end(main_checkout):
    session, session_base = current_session(main_checkout)
    head = git("rev-parse", "HEAD")
    remote = origin_endpoint()
    branch, base = fetch_default(remote)
    if session == branch:
        raise SessionError("the default branch cannot be ended")
    require_ancestor(head, base, f"session HEAD is not on origin/{branch}")
    if current_session(main_checkout) != (session, session_base) or git("rev-parse", "HEAD") != head:
        raise SessionError("the session changed during cleanup; run end again")
    # Move the checkout away from its working path before the last inspection.
    # A refused cleanup restores the original path or leaves the files at the
    # holding path if something else has occupied the original one.
    original_gitfile = (ROOT / ".git").read_bytes()
    holding = Path(tempfile.mkdtemp(prefix=f".{ROOT.name}-end-", dir=ROOT.parent))
    moved = holding / "checkout"
    archive = holding / "files"
    gitfile = holding / "worktree-gitfile"
    try:
        git("worktree", "move", ROOT, moved, cwd=main_checkout)
        if default_tip(remote, cwd=moved) != (branch, base):
            raise SessionError("origin's default branch changed during cleanup; run end again")
        if (current_session(main_checkout, cwd=moved) != (session, session_base)
                or git("rev-parse", "HEAD", cwd=moved) != head):
            raise SessionError("the session changed before removal")
        (moved / ".git").rename(gitfile)
        moved.rename(archive)
        # Git only removes the registration of the now-missing worktree.
        # Processes still in that directory continue writing to the archive.
        try:
            git("worktree", "remove", moved, cwd=main_checkout)
        except (OSError, subprocess.CalledProcessError) as error:
            raise SessionError("could not unregister the checkout") from error
    except (SessionError, OSError, subprocess.CalledProcessError, KeyboardInterrupt) as error:
        if archive.exists() or moved.exists():
            try:
                if ROOT.exists() or ROOT.is_symlink():
                    raise SessionError("the original path or worktree registration is unavailable")
                if registered_worktree(moved, main_checkout):
                    if archive.exists():
                        archive.rename(moved)
                    if gitfile.exists():
                        gitfile.rename(moved / ".git")
                    git("worktree", "move", moved, ROOT, cwd=main_checkout)
                elif (registered_worktree(ROOT, main_checkout) and moved.is_dir()
                      and (moved / ".git").read_bytes() == original_gitfile):
                    moved.rename(ROOT)
                else:
                    raise SessionError("the original worktree registration is unavailable")
                if not registered_worktree(ROOT, main_checkout):
                    nested = ROOT / moved.name
                    if registered_worktree(nested, main_checkout):
                        git("worktree", "move", nested, moved, cwd=main_checkout)
                    raise SessionError("Git did not restore the worktree at its original path")
            except (SessionError, OSError, subprocess.CalledProcessError, KeyboardInterrupt) as restore_error:
                location = archive if archive.exists() else moved
                if not location.exists() and (ROOT / moved.name).exists():
                    location = ROOT / moved.name
                pointer = gitfile if gitfile.exists() else location / ".git"
                raise SessionError(
                    f"could not restore the checkout; files at {location}, Git pointer at {pointer}"
                ) from restore_error
            if isinstance(error, SessionError):
                raise SessionError(f"{error}; restored {ROOT}") from error
        raise
    finally:
        if not moved.exists() and not archive.exists():
            holding.rmdir()
    print(f"Checkout files retained at {archive}", flush=True)
    print(f"Ended {session}; the local branch is retained")


def main():
    signal.signal(signal.SIGTERM, terminate_session)
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("start", help="create a sibling worktree from origin's default branch").add_argument("name")
    commands.add_parser("list", help="list local worktrees")
    commands.add_parser("land", help="rebase, review, qualify and push the session").add_argument(
        "--dry-run", action="store_true", help="run the landing checks and preview the push",
    )
    commands.add_parser("end", help="remove a clean session whose HEAD reached the default branch")
    args = parser.parse_args()

    try:
        common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir"))
        main_checkout = common.parent
        if common.name != ".git" or not (main_checkout / ".git").is_dir():
            raise SessionError("sessions require a standard clone with a .git directory")
        if args.command == "list":
            git("worktree", "list", capture=False)
        elif args.command == "start":
            start(main_checkout, args.name)
        else:
            with (common / "protonmailcli-landing.lock").open("a") as lock:
                print("Waiting for the landing turn", flush=True)
                fcntl.flock(lock, fcntl.LOCK_EX)
                if args.command == "land":
                    land(main_checkout, args.dry_run)
                else:
                    end(main_checkout)
    except subprocess.CalledProcessError as error:
        print(f"session: git {error.cmd[3]} exited {error.returncode}", file=sys.stderr)
        return 1
    except (SessionError, OSError) as error:
        print(f"session: {error}", file=sys.stderr)
        return 1
    except SessionTerminated:
        print("session: terminated", file=sys.stderr)
        return 143
    except KeyboardInterrupt:
        print("session: interrupted", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
